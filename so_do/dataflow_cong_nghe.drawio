<mxCell id="giam-sat_6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Next.js&lt;/b&gt;&lt;br&gt;lỗi JS, thời gian tải trang (Web Vitals),&lt;br&gt;thời gian gọi API phía trình duyệt" vertex="1"><mxGeometry x="45" y="140" width="350" height="90" as="geometry"/></mxCell>
<mxCell id="giam-sat_7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;FastAPI&lt;/b&gt;&lt;br&gt;request log (JSON), mã lỗi, độ trễ&lt;br&gt;theo endpoint, trace_id mỗi request" vertex="1"><mxGeometry x="45" y="260" width="350" height="90" as="geometry"/></mxCell>
<mxCell id="giam-sat_8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Worker&lt;/b&gt;&lt;br&gt;thời gian từng bước (sniff, luật, AI, kiểm tra),&lt;br&gt;số dòng, mã cảnh báo, luật hay AI quyết định,&lt;br&gt;token và USD mỗi lần gọi OpenAI" vertex="1"><mxGeometry x="45" y="380" width="350" height="110" as="geometry"/></mxCell>
<mxCell id="giam-sat_9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;PostgreSQL, Redis&lt;/b&gt;&lt;br&gt;kết nối, truy vấn chậm, độ dài hàng đợi" vertex="1"><mxGeometry x="45" y="520" width="350" height="80" as="geometry"/></mxCell>
<mxCell id="giam-sat_10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Bảng nghiệp vụ trong PostgreSQL&lt;/b&gt;&lt;br&gt;review_items, overrides, llm_calls" vertex="1"><mxGeometry x="45" y="620" width="350" height="70" as="geometry"/></mxCell>

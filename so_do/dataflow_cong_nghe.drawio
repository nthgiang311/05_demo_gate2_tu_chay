<mxCell id="giam-sat_35" parent="1" edge="1" source="giam-sat_15" target="giam-sat_17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" value=""><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="giam-sat_36" parent="1" edge="1" source="giam-sat_13" target="giam-sat_17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.8;" value=""><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="giam-sat_37" parent="1" edge="1" source="giam-sat_13" target="giam-sat_18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.8;" value=""><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="giam-sat_38" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Giai đoạn triển khai gợi ý&lt;/b&gt; (không cần dựng đủ ngay)&lt;br&gt;&lt;br&gt;&lt;b&gt;Bước 1, pilot vài nhà thuốc:&lt;/b&gt; log JSON có trace_id + Sentry + bảng llm_calls và review_items trong PostgreSQL; một trang Grafana đọc thẳng PostgreSQL. Đủ để biết tool có sai và tốn bao nhiêu.&lt;br&gt;&lt;b&gt;Bước 2, nhiều người dùng:&lt;/b&gt; thêm OpenTelemetry Collector, Prometheus, Loki, Tempo và cảnh báo qua Alertmanager.&lt;br&gt;&lt;b&gt;Bước 3:&lt;/b&gt; Langfuse (hoặc tương đương) để xem lại prompt khi AI đề xuất sai; dashboard chất lượng theo từng nhà cung cấp.&lt;br&gt;&lt;br&gt;&lt;b&gt;Bảo mật khi giám sát:&lt;/b&gt; không ghi nguyên nội dung file báo giá vào log; chỉ ghi file_id, số dòng, mã cảnh báo. Prompt gửi OpenAI chỉ lưu khi bật chế độ gỡ lỗi." vertex="1"><mxGeometry x="20" y="740" width="1860" height="220" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>

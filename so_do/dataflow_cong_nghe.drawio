<mxCell id="kien-truc_10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Trang React (App Router)&lt;/b&gt;&lt;br&gt;Upload · Bảng chuẩn 6 trường&lt;br&gt;Hàng đợi duyệt · Giữ/Bỏ · Đổi cột&lt;br&gt;Duyệt · Tải file MISA&lt;br&gt;&lt;i&gt;TanStack Query gọi API, poll trạng thái job&lt;/i&gt;" vertex="1"><mxGeometry x="300" y="150" width="330" height="120" as="geometry"/></mxCell>
<mxCell id="kien-truc_11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Route Handlers / Server Actions&lt;/b&gt; (BFF)&lt;br&gt;gắn token người dùng, gọi FastAPI,&lt;br&gt;ẩn địa chỉ backend và khoá API&lt;br&gt;&lt;i&gt;không chứa logic chuẩn hoá&lt;/i&gt;" vertex="1"><mxGeometry x="300" y="330" width="330" height="110" as="geometry"/></mxCell>
<mxCell id="kien-truc_12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Auth.js (NextAuth)&lt;/b&gt;&lt;br&gt;đăng nhập, phát JWT có user_id, vai trò" vertex="1"><mxGeometry x="300" y="500" width="330" height="80" as="geometry"/></mxCell>
<mxCell id="kien-truc_13" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Hợp đồng FE ↔ BE&lt;/b&gt;&lt;br&gt;REST + JSON, OpenAPI sinh tự động từ FastAPI;&lt;br&gt;FE sinh kiểu TypeScript từ openapi.json&lt;br&gt;(openapi-typescript) để hai bên không lệch.&lt;br&gt;File lớn: multipart, tối đa 10 MB." vertex="1"><mxGeometry x="300" y="630" width="330" height="150" as="geometry"/></mxCell>
<mxCell id="kien-truc_14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;API /api/v1&lt;/b&gt; (FastAPI + Pydantic)&lt;br&gt;POST /files · GET /files/{id}/grid&lt;br&gt;POST /jobs · GET /jobs/{id}&lt;br&gt;POST /jobs/{id}/overrides · POST /jobs/{id}/approve&lt;br&gt;POST /jobs/{id}/exports · GET /exports/{id}" vertex="1"><mxGeometry x="710" y="150" width="410" height="130" as="geometry"/></mxCell>
<mxCell id="kien-truc_15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Worker chuẩn hoá&lt;/b&gt; (arq / Celery, cùng code Python)&lt;br&gt;&lt;br&gt;sniff → đọc lưới (openpyxl, xlrd)&lt;br&gt;→ tìm bảng, dòng tiêu đề&lt;br&gt;→ &lt;b&gt;luật ánh xạ cột&lt;/b&gt;&lt;br&gt;→ &lt;i&gt;AI đề xuất cột nếu luật không chắc&lt;/i&gt;&lt;br&gt;→ luật kiểm tra lại đề xuất&lt;br&gt;→ đọc dòng, chuẩn hoá giá, kiểm tra&lt;br&gt;(LangGraph điều phối các bước)" vertex="1"><mxGeometry x="710" y="340" width="410" height="200" as="geometry"/></mxCell>
<mxCell id="kien-truc_16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Override + Duyệt&lt;/b&gt;&lt;br&gt;chạy lại bằng luật,&lt;br&gt;0 lần gọi AI;&lt;br&gt;chặn Duyệt khi&lt;br&gt;còn mục chặn" vertex="1"><mxGeometry x="710" y="600" width="195" height="110" as="geometry"/></mxCell>
<mxCell id="kien-truc_17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Xuất MISA&lt;/b&gt;&lt;br&gt;misa_export.py&lt;br&gt;mẫu 61 cột, giá là ô số;&lt;br&gt;báo cáo dòng bị bỏ" vertex="1"><mxGeometry x="925" y="600" width="195" height="110" as="geometry"/></mxCell>
<mxCell id="kien-truc_18" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;br&gt;users · suppliers&lt;br&gt;files (trạng thái, hash)&lt;br&gt;jobs (mode, status, thời gian)&lt;br&gt;normalized_rows&lt;br&gt;review_items (mã cảnh báo)&lt;br&gt;overrides (ai sửa, sửa gì)&lt;br&gt;approvals · exports&lt;br&gt;llm_calls (token, USD, cache)&lt;br&gt;supplier_profiles &lt;i&gt;(nhớ bố cục)&lt;/i&gt;" vertex="1"><mxGeometry x="1200" y="150" width="320" height="300" as="geometry"/></mxCell>
<mxCell id="kien-truc_19" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Object storage&lt;/b&gt; (S3 / MinIO)&lt;br&gt;raw/ file gốc người dùng tải lên&lt;br&gt;exports/ file MISA đã xuất" vertex="1"><mxGeometry x="1200" y="490" width="320" height="120" as="geometry"/></mxCell>

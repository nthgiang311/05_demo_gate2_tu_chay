<mxCell id="kien-truc_21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;OpenAI API&lt;/b&gt; gpt-4o-mini&lt;br&gt;nhận: tiêu đề + vài dòng mẫu&lt;br&gt;trả: đề xuất dòng tiêu đề và cột&lt;br&gt;&lt;b&gt;không bao giờ trả giá trị ô&lt;/b&gt;" vertex="1"><mxGeometry x="1595" y="340" width="260" height="150" as="geometry"/></mxCell>

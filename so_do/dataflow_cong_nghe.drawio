<diagram id="giam-sat" name="3. Giám sát (monitor)"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="giam-sat_1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;" value="&lt;b&gt;Giám sát: hệ thống chạy có ổn không, và AI có đang làm sai không&lt;/b&gt;&lt;br&gt;Ba lớp: lỗi kỹ thuật · hiệu năng · chất lượng dữ liệu và chi phí AI" vertex="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell>
<mxCell id="giam-sat_2" parent="1" style="swimlane;startSize=34;html=1;fillColor=#eef3fb;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;rounded=1;arcSize=3;" value="Nguồn phát tín hiệu" vertex="1"><mxGeometry x="20" y="90" width="400" height="620" as="geometry"/></mxCell>

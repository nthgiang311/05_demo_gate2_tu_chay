<mxCell id="giam-sat_13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Truy vấn SQL định kỳ&lt;/b&gt;&lt;br&gt;(Grafana đọc thẳng PostgreSQL)&lt;br&gt;tính chỉ số chất lượng theo ngày" vertex="1"><mxGeometry x="470" y="560" width="270" height="110" as="geometry"/></mxCell>

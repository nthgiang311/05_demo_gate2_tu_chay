<mxCell id="giam-sat_32" parent="1" edge="1" source="giam-sat_11" target="giam-sat_16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;" value="traces"><mxGeometry relative="1" as="geometry"/></mxCell>
